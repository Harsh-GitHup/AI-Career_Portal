# Django Configuration
DJANGO_SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uncomment ONE of the following to use a specific database.
# If none are uncommented, it defaults to SQLite (db.sqlite3).
# Database Configuration
# DATABASE_URL=mysql://user:password@hostname:3306/ai_career_db # MySQL
# DATABASE_URL=postgres://user:password@hostname:5432/ai_career_db # Postgres

# Google OAuth & Gemini API (For Core Resume Parsing & Chatbot)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Redis (For Celery Task Queue)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# External APIs (For Universal Opportunity Scraper)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
YOUTUBE_API_KEY=your_youtube_api_key
